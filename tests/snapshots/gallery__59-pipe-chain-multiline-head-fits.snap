---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[
  _type == $type
  && nationalDexNumber >= 1
  && nationalDexNumber <= 151
  && count(types[
    lower(@->name) == "water"
  ]) > 0
]
  | score(boost(name match $q, 2))
  | order(_score desc) {
    name,
    nationalDexNumber
  }
