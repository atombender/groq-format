*[_type == 'page' && slug.current == $slug][0]{
    _id, _type, name, slug, heading, subheading,
    "pageBuilder": pageBuilder[]{
      ...,
      _type == "callToAction" => {
        ...,
        button { ..., link { ..., _type == "link" => { "page": page->slug.current, "post": post->slug.current } } }
      },
      _type == "infoSection" => {
        content[]{ ..., markDefs[]{ ..., _type == "link" => { "page": page->slug.current, "post": post->slug.current } } }
      },
    },
  }
