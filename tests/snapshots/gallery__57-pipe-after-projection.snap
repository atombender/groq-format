---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[
  _type == "post"
  && published == true
  && category
    in ["tech", "science", "culture"]
] {
  title,
  "slug": slug.current,
  "excerpt": pt::text(body)[0...200],
  author->{
    name,
    "avatar": image.asset->url
  },
  categories[]->{ title, slug },
  _createdAt
}[0...10] | order(_createdAt desc)
