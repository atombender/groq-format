---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[
  _type == "post"
  && defined(slug.current)
  && !(_id in path("drafts.**"))
] | order(publishedAt desc)[0...12] {
  _id,
  title,
  "slug": slug.current,
  publishedAt,
  excerpt,
  "author": author->{
    name,
    "image": image.asset->url
  },
  "categories": categories[]->{
    title,
    "slug": slug.current
  }
}
