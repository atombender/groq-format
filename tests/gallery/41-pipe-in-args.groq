*[_type == "category"] {
  title,
  "topPosts": array::join(*[_type == "post" && references(^._id)] | order(views desc)[0...5].title, ", "),
  "postCount": count(*[_type == "post" && references(^._id) && defined(publishedAt)] | order(publishedAt desc)),
  "newest": coalesce(*[_type == "post" && references(^._id)] | order(publishedAt desc)[0].title, "none")
}
