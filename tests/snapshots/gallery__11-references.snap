---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[
  _type == "post"
  && references(
    *[
      _type == "category"
      && slug.current == $slug
    ]._id
  )
] | order(publishedAt desc) {
  title,
  "slug": slug.current
}
