---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[_type == "post"] // all posts
  | score(title match $q) // by relevance
  // newest first among equals
  | order(
    _score desc,
    _createdAt desc
  )[0...10] { title }
