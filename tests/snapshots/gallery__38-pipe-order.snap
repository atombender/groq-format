---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[
  _type == "post"
  && defined(slug.current)
  && !(_id in path("drafts.**"))
]
  | order(
    publishedAt desc,
    title asc
  )[0...20] {
    _id,
    title,
    "slug": slug.current,
    "author": author->name,
    publishedAt,
    "categories": categories[]->title
  }
