---
source: tests/gallery.rs
expression: snapshot
---
--- width 40
*[_type == "post"] {
  "categories": categories[]->title,
  "authorName": author->name,
  "authorImage":
    author->image.asset->url,
  "firstCategory": categories[0]->{
    title,
    "slug": slug.current
  }
}
